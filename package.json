{
  "name": "kalimba-cat-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "fake-indexeddb": "latest",
    "tsx": "latest",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "latest"
  }
}
